{
  "name": "naya-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "turbo run dev --filter=@naya/web",
    "build": "turbo run build",
    "start": "pnpm --filter @naya/web start",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"apps/*/app/**/*.{ts,tsx,css}\" \"apps/*/components/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"apps/*/app/**/*.{ts,tsx,css}\" \"apps/*/components/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.5.0",
    "typescript": "^5.7.2"
  }
}
